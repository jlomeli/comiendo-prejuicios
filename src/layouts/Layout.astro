---
import { getImage } from "astro:assets";
import heroPhoto from "@/assets/images/hero-plant-sunlight.jpg";
import "../index.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Comiendo Prejuicios — Dra. Claudia Gomez · Terapia ACT · Trastornos alimentarios · Trauma",
	description = "Terapia ACT con la Dra. Claudia Gomez, especializada en trastornos alimentarios, trauma y espacios neurodivergente-friendly. Consulta gratuita en línea.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({
	src: heroPhoto,
	width: 1200,
	height: 630,
	fit: "cover",
	format: "jpg",
});
const ogImageUrl = new URL(ogImage.src, Astro.site);

const structuredData = {
	"@context": "https://schema.org",
	"@type": "Psychologist",
	name: "Comiendo Prejuicios · Dra. Claudia Gomez",
	description,
	url: canonicalUrl.href,
	image: ogImageUrl.href,
	email: "claudia@comiendoprejuicios.com",
	telephone: "+52 33 1853 0646",
	address: {
		"@type": "PostalAddress",
		addressLocality: "Ciudad de México",
		addressCountry: "MX",
	},
	availableLanguage: "es",
	sameAs: ["https://instagram.com/comiendoprejuicios"],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Comiendo Prejuicios" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Una planta bañada por luz cálida de atardecer contra un muro texturizado" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;1,400&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
	</head>
	<body>
		<!-- Skip navigation link — first focusable element in the DOM, visually hidden until focused -->
		<a href="#main-content" class="skip-link">Saltar al contenido principal</a>
		<slot />
	</body>
</html>
